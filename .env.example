APP_NAME="Chat API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chat_app
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Register BOTH callbacks below as authorized redirect URIs.
# API clients receive a Sanctum bearer token from this callback:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
# The browser (Livewire) UI gets a session cookie and is redirected to /chat:
GOOGLE_WEB_REDIRECT_URI="${APP_URL}/auth/google/callback"

# CORS: origins allowed to call this API from another domain (comma separated).
# The Livewire UI is served from APP_URL, so it does not need an entry here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sanctum stateful (cookie) domains. Bearer-token clients do not need this,
# but browser sessions must be listed for first-party cookie auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

# Real-time broadcasting (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=chat-api
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Values the browser uses to open the WebSocket. In Docker/production the
# server may reach Reverb at a private hostname while browsers use a public
# one; set these to the public address (defaults mirror the values above).
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

# Browser origins allowed to open the WebSocket (comma separated).
REVERB_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
