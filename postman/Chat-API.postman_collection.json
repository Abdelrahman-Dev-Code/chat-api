{
  "info": {
    "_postman_id": "aa018d6a-84fb-4b54-a3a6-252b2a1ab718",
    "name": "Chat API",
    "description": "PostgreSQL-backed Laravel chat API. Start the app at http://127.0.0.1:8000, then set the access_token collection variable after completing Google OAuth. No credentials or tokens are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "google_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauth_state",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Google sign-in URL",
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/google/redirect",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "redirect"
              ]
            },
            "description": "Returns a Google consent URL. Open the returned url in a browser and complete Google sign-in. Google must redirect to the API callback configured for this application."
          },
          "response": []
        },
        {
          "name": "Exchange Google code for token",
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/google/callback?code={{google_code}}&state={{oauth_state}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{google_code}}"
                },
                {
                  "key": "state",
                  "value": "{{oauth_state}}"
                }
              ]
            },
            "description": "Complete Google OAuth in a browser, then enter the callback code and state here. The state is single-use and expires after 10 minutes. A successful response saves its token to the access_token collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OAuth callback succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('access_token', body.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get current profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Requires access_token."
          },
          "response": []
        },
        {
          "name": "Revoke current token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the token in access_token. After success, sign in again to make authenticated requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "List latest messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/messages?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns 10 messages per page, newest first. Deleted messages are excluded."
          },
          "response": []
        },
        {
          "name": "Filter messages by authors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/messages?user_ids[]={{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages"
              ],
              "query": [
                {
                  "key": "user_ids[]",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Set user_id to a positive user ID. Repeat the user_ids[] query parameter to filter by multiple authors (up to 50)."
          },
          "response": []
        },
        {
          "name": "Create message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "description": "Creates and broadcasts a message. The authenticated user is used as the author. On success, the response data.id is saved as message_id for the edit/delete examples."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Message created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('message_id', String(body.data.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Edit message",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages/{{message_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "{{message_id}}"
              ]
            },
            "description": "Only the author can edit a message. First run Create message to set message_id."
          },
          "response": []
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/messages/{{message_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "{{message_id}}"
              ]
            },
            "description": "Soft-deletes the message. Only the author can delete it. First run Create message to set message_id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Realtime",
      "item": [
        {
          "name": "Authorize private chat channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "socket_id",
                  "value": "1234.5678",
                  "type": "text"
                },
                {
                  "key": "channel_name",
                  "value": "private-chat",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/broadcasting/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "broadcasting",
                "auth"
              ]
            },
            "description": "Demonstrates authenticated private-channel authorization. For a real Echo/Reverb connection, socket_id must come from the connected WebSocket client."
          },
          "response": []
        }
      ]
    }
  ]
}
